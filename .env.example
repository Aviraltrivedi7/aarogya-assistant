# AarogyaGPT environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (required only for /api/status endpoints)
MONGO_URL=mongodb://localhost:27017

# Database name inside the MongoDB cluster
DB_NAME=aarogya

# Comma-separated list of allowed CORS origins for the API.
# Leave unset for open access (development); set real origins in production,
# e.g. https://yourapp.example.com
CORS_ORIGINS=

# Secret used to sign login tokens (HMAC). Set a long random string in
# production — if unset, a dev default is used and tokens reset on restart.
AUTH_SECRET=

# OpenAI — powers richer AI assistant answers (server-side only; the key
# is never sent to the browser). Leave both unset to run on the built-in
# rule-based triage engine instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
